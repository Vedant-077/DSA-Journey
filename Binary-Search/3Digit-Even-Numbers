#include<vector>
#include<set>
using namespace std;

class Solution {
public:
    vector<int> findEvenNumbers(vector<int>& digits) {
        int n = digits.size();
        set<int> st;

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < n; j++)
            {
                for (int k = 0; k < n; k++)
                {
                    
                    if (i == j || j == k || i == k)
                    {
                        continue;
                    }

                    
                    if (digits[k] % 2 != 0)
                    {
                        continue;
                    }

                    
                    if (digits[i] == 0)
                    {
                        continue;
                    }

                    int number = digits[i] * 100
                               + digits[j] * 10
                               + digits[k];

                    st.insert(number);
                }
            }
        }

        
        vector<int> ans(st.begin(), st.end());

        return ans;
    }
};